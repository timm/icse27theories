# macOS
.DS_Store

# Python venv
.venv/
__pycache__/
*.pyc

# External tool installs (large, re-clone/download per README)
extract/tools/

# Cloned datasets (large, public — re-clone from upstream)
extract/data/helix/git_repo/
extract/data/*/git_repo/
extract/data/helix_clean/
extract/data/*/mod_mbox/
extract/data/*/bk_mod_mbox/
extract/data/*/pipermail/
extract/data/*/jira/
extract/data/*/github/

# Large derived artifacts (re-generate via scripts/szz_*.py + RefactoringMiner)
extract/data/*/derived/refminer*.json

# Source zips from Carlos's Drive bundle (large; re-download manually)
extract/data/_zips/

# Large mbox files (some Apache projects have multi-GB mbox archives)
extract/data/*/mbox/*.mbox
extract/data/*/bk_mod_mbox/
extract/data/*/mod_mbox/

# Editor / IDE
*.swp
.idea/
.vscode/

# Claude Code local config
.claude/

# Depends cwd output (writes here regardless of -o flag)
depends.log
depends-dv8map.mapping
